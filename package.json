{
  "name": "akdeniznet-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-messages.mjs",
    "contrast:check": "node scripts/check-contrast.mjs",
    "data:check": "node --disable-warning=ExperimentalWarning scripts/check-data.mjs",
    "test:e2e": "playwright test",
    "e2e": "next build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run i18n:check && npm run contrast:check && npm run data:check"
  },
  "dependencies": {
    "@cloudflare/speedtest": "1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
